!肌肉

Set_Pipeline_Parameter
/PARAMETER_NAME=PELVIS_MARKERS
/PARAMETER_VALUE=R_IAS+L_IAS+R_IPS+L_IPS
;

Set_Pipeline_Parameter
/PARAMETER_NAME=LEFT_THIGH_MARKERS
/PARAMETER_VALUE=L_GT+L_FLE+L_FME
;

Set_Pipeline_Parameter
/PARAMETER_NAME=RIGHT_THIGH_MARKERS
/PARAMETER_VALUE=R_GT+R_FLE+R_FME
;

Set_Pipeline_Parameter
/PARAMETER_NAME=LEFT_SHANK_MARKERS
/PARAMETER_VALUE=L_SK1+L_FAL+L_TAM
;

Set_Pipeline_Parameter
/PARAMETER_NAME=RIGHT_SHANK_MARKERS
/PARAMETER_VALUE=R_SK1+R_FAL+R_TAM
;

Set_Pipeline_Parameter
/PARAMETER_NAME=LEFT_FOOT_MARKERS
/PARAMETER_VALUE=L_FCC+ L_FM1 + L_FM5
;

Set_Pipeline_Parameter
/PARAMETER_NAME=RIGHT_FOOT_MARKERS
/PARAMETER_VALUE=R_FCC+ R_FM1 + R_FM5
;

TERRY_Lt_Adductor_Group
/MODEL_NAME=::MODEL_NAME
/PELVIS_MARKERS=::PELVIS_MARKERS
/LEFT_THIGH_MARKERS=::LEFT_THIGH_MARKERS
/LEFT_SHANK_MARKERS=::LEFT_SHANK_MARKERS
;

