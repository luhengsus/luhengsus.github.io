Set_Force_Platform_Threshold

/THRESHOLD=20

! /SET_AS_DEFAULT=FALSE

;

FP_Auto_Baseline

! /FP_NUMBER=

/AUTO_ZERO=TRUE

/AUTO_FP_MINIMUM=TRUE

/USE_REDUCED_FP_MINIMUM_AROUND_FORCE=TRUE

! /REDUCED_FP_MINIMUM=5.0

;

Lowpass_Filter
/SIGNAL_TYPES=TARGET+ANALOG
/SIGNAL_FOLDER=ORIGINAL+ORIGINAL
! /SIGNAL_NAMES=
! /RESULT_FOLDER=PROCESSED
! /RESULT_SUFFIX=
! /FILTER_CLASS=BUTTERWORTH
/FREQUENCY_CUTOFF=15
! /NUM_REFLECTED=6
! /NUM_EXTRAPOLATED=0
! /TOTAL_BUFFER_SIZE=6
! /NUM_BIDIRECTIONAL_PASSES=1
;

Event_Explicit
/EVENT_NAME=IC
! /FRAME=
! /TIME=
;

Event_Explicit
/EVENT_NAME=TO
! /FRAME=
! /TIME=
;

Set_Use_Processed_Targets
/USE_PROCESSED=TRUE
;

Set_Use_Processed_Analog
/USE_PROCESSED=TRUE
;

Recalc

;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=L_IAS+L_IPS+R_IAS+R_IPS
! /FILE_NAME=
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=Z
/SIGNAL_PRECISION=5
/EVENT_SEQUENCE=IC+TO
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
