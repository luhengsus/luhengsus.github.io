	! Skip for Ben Hogan
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=((Data_Exists(TARGET::ORIGINAL::L_LMal) &::AMP& Data_Exists(TARGET::ORIGINAL::L_1st)) <> 1)
	! /AS_INTEGER=TRUE
	;
	
		!Try funcional knee only if Functional trial exists
		Set_Pipeline_Parameter_To_List_Of_Tags
		/PARAMETER_NAME=all_tags
		;

		For_Each
		/ITERATION_PARAMETER_NAME=tag_name
		! /ITERATION_PARAMETER_COUNT_NAME=
		/ITEMS=::all_tags
		;

			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=("&::tag_name&" = "Functional")
			! /AS_INTEGER=TRUE
			;
			
				Associate_Functional_Joints_With_Files
				/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
				/FILE_NAME=Functional
				/LANDMARKS=F_RKNEE+F_LKNEE
				/START_FRAME=1+1
				/END_FRAME=EOF
				/COMPUTE_LANDMARK=TRUE
				;
				
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;

		End_For_Each
		/ITERATION_PARAMETER_NAME=tag_name
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Set_Subject_Height
	/CALIBRATION_FILE=*Static*.c3d
	/HEIGHT=<?=$session["Height"];?> 
	! /UNITS=m
	;

	Set_Subject_Weight
	/CALIBRATION_FILE=*Static*.c3d
	/WEIGHT=<?=$session["Weight"];?> 
	! /UNITS=Kg
	;

	Assign_Model_File
	/CALIBRATION_FILE=*Static*.c3d
	/MOTION_FILE_NAMES=ALL_FILES
	! /REMOVE_EXISTING_ASSIGNMENTS=FALSE
