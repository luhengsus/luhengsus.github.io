	Conditional_Statement
	/ITERATION_PARAMETER_NAME=sports_marker_set
	/EXPRESSION=Data_Exists(TARGET::ORIGINAL::WaistLFront)
	! /AS_INTEGER=TRUE
	;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=pelvis
		/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::WaistL) <> 1)
		! /AS_INTEGER=TRUE
		;

			Apply_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Pelvis.mdh
			! /SET_PROMPT=Open model file
			/VIEW_BUILDMODEL_RESULTS=0
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=pelvis
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=pelvis
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::WaistL)
		! /AS_INTEGER=TRUE
		;

			Apply_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Pelvis_IC.mdh
			! /SET_PROMPT=Open model file
			/VIEW_BUILDMODEL_RESULTS=0
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=pelvis
		;
		
		<? if ($functional_trial_exists) {
		?> 
			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Lower_Body_sports.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;
		<?
		}
		else {
		?> 
			Select_Active_File
			/FILE_NAME=Static
			! /QUERY=
			;
			
			! check if L/RKneeIn target exists
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=KneeIn
			/EXPRESSION=Data_Exists(TARGET::ORIGINAL::LKneeIn) | Data_Exists(TARGET::ORIGINAL::RKneeIn)
			! /AS_INTEGER=TRUE
			;
			
				! if yes, add model using medial knee markers
				Append_Model_Template
				/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
				/MODEL_TEMPLATE=<?=$modelDirectory;?>Lower_Body_sports_wo_FKnee.mdh
				/VIEW_BUILDMODEL_RESULTS=0
				;
				
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=KneeIn
			;
			
			!else halt the script
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=KneeIn
			/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::LKneeIn) | Data_Exists(TARGET::ORIGINAL::RKneeIn)) <> 1
			! /AS_INTEGER=TRUE
			;
			
				Pipeline_Breakpoint
				/PAUSE_MESSAGE=Model cannot be created because functional trial is not selected and at the same time medial knee markers (LKneeIn and RKneeIn) were not found in static trial. Please halt the execution. Either activate functional trial or add medial knee markers to static trial.
				;
				
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=KneeIn
			;
		<?
		}?> 
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::SpineThoracic12)
		! /AS_INTEGER=TRUE
