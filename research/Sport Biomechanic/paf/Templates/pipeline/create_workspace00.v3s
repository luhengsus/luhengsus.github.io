;

!=============================
!Open files
!=============================

<?
$functional_trial_exists = false;

// Load movement files and add tags.
foreach($measurements as $m) {
	$path_parts = pathinfo($m["Filename"]);

	if (strstr($m["Used"], "True") && strpos($subsession['Model_used'],'Theia') === false) {
		if (strpos($path_parts['filename'], 'Functional') !== false) {
			$tag = 'Functional';
			$functional_trial_exists = true;
?>
			File_Open 
			/FILE_NAME=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
			/SET_PROMPT=Open functional trial
			; 
			
			!Add tag to each file
			Assign_Tags_To_Files
			/MOTION_FILE_NAMES=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
			! /QUERY=
			/TAGS=<?=$tag;?> 
			; 
	<?
		}
		elseif (strpos($path_parts['filename'], 'Static') !== false) {
			$tag = 'Static';
?> 
			File_Open 
			/FILE_NAME=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
			/SET_PROMPT=Open static trial
			; 
			
			!Add tag to each file
			Assign_Tags_To_Files
			/MOTION_FILE_NAMES=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
			! /QUERY=
			/TAGS=<?=$tag;?> 
			; 
<? 
		}
	}
	
	if (strstr($m["Used"], "True") && strpos($subsession['Model_used'],'Theia') !== false) {
		$tag = 'Static';

		include ($v3dScriptDirectory . 'pipeline_open_files_Theia.v3s');
	}
}

if (strpos($subsession['Model_used'],'Theia') === false) {
?> 

	File_Rename
	/EXISTING_FILE_NAME=<?=$working_directory?>*Static*.c3d
	/NEW_FILE_NAME=Stand.c3d
	! /USE_SEARCH_REPLACE=FALSE
	! /SEARCH_FOR=
	! /REPLACE_WITH=
	! /REMOVE_FILE_PATH=FALSE
	/RENAME_STATIC_CALIBRATION_FILES=TRUE
	;

	Create_Hybrid_Model
	/CALIBRATION_FILE=<?=$working_directory?>Static*.c3d
	! /SUFFIX=
	! /RANGE=ALL_FRAMES
	;
	
	! Remove prefix 'Q_' if Skeleton solver Sports marker set is used.
	Remove_Prefix_From_Point_Labels
	/PREFIX=Q_
	! /INCLUDE_CAL_FILE=TRUE
	! /OVERWRITE_C3D_FILE=FALSE
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=ifd_marker_set
	/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::L_PM6) &::AMP& Data_Exists(TARGET::ORIGINAL::L_MCAL))
	! /AS_INTEGER=TRUE
	;

		Apply_Model_Template
		/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
		/MODEL_TEMPLATE=<?=$modelDirectory;?>model_IFD_Lowerbody.mdh
		! /SET_PROMPT=Open model file
		/VIEW_BUILDMODEL_RESULTS=0
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::TV2)
		! /AS_INTEGER=TRUE
		;

			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Thorax_IFD.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::L_HLE)
		! /AS_INTEGER=TRUE
		;

			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Arms_IFD.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::L_HM2)
		! /AS_INTEGER=TRUE
		;

			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Hands.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::SGL)
		! /AS_INTEGER=TRUE
		;

			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Head.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=Data_Exists(TARGET::ORIGINAL::L_TLR)
		! /AS_INTEGER=TRUE
		;

			Append_Model_Template
			/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
			/MODEL_TEMPLATE=<?=$modelDirectory;?>Tibia_plateau.mdh
			/VIEW_BUILDMODEL_RESULTS=0
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=ifd_marker_set
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=ben_hogan_marker_set
	/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::L_LMal) &::AMP& Data_Exists(TARGET::ORIGINAL::L_1st))
	! /AS_INTEGER=TRUE
	;

		Apply_Model_Template
		/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
		/MODEL_TEMPLATE=<?=$modelDirectory;?>BenHogan.mdh
		! /SET_PROMPT=Open model file
		/VIEW_BUILDMODEL_RESULTS=0
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=ben_hogan_marker_set
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=meyer_marker_set
	/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::LLAMA) &::AMP& Data_Exists(TARGET::ORIGINAL::LDIHE))
	! /AS_INTEGER=TRUE
	;

		Apply_Model_Template
		/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
