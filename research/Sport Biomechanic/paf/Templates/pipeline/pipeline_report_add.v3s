Open_Report_Template
/REPORT_TEMPLATE=<?=$reportTemplateDirectory . $report_template;?> 
! /SET_PROMPT=Open report template
;

! Calculate GRF from terminal segment. Theia model is using toe segment while markerbased model uses foot.
<?
if (strpos($model_used,'Theia') !== false) {
?> 

	Compute_Model_Based_Data
	/RESULT_NAME=Right GRF
	/SUBJECT_TAG=
	/FUNCTION=GRF_DATA
	/SEGMENT=RTO
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=Virtual Lab
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	/NEGATEX=TRUE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Left GRF
	/SUBJECT_TAG=
	/FUNCTION=GRF_DATA
	/SEGMENT=LTO
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=Virtual Lab
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEED=0.0
	;
	
	! Following overrides settings from $report_template
	Compute_Model_Based_Data
	/RESULT_NAME=Left Ankle Power
	/SUBJECT_TAG=
	/FUNCTION=JOINT_POWER
	/SEGMENT=LFT_S
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=LSK
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	/NEGATEY=TRUE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Ankle Power
	/SUBJECT_TAG=
	/FUNCTION=JOINT_POWER
	/SEGMENT=RFT_S
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=RSK
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	/NEGATEY=TRUE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Left Ankle Moment
	/SUBJECT_TAG=
	/FUNCTION=JOINT_MOMENT
	/SEGMENT=LFT_S
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=LSK
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	/NEGATEX=TRUE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Ankle Moment
	/SUBJECT_TAG=
	/FUNCTION=JOINT_MOMENT
	/SEGMENT=RFT_S
	/REFERENCE_SEGMENT=
	/RESOLUTION_COORDINATE_SYSTEM=RSK
	! /USE_CARDAN_SEQUENCE=FALSE
	/NORMALIZATION=TRUE
	/NORMALIZATION_METHOD=DEFAULT_NORMALIZATION
	! /NORMALIZATION_METRIC=
	/NEGATEX=TRUE
	/NEGATEY=TRUE
	/NEGATEZ=TRUE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
