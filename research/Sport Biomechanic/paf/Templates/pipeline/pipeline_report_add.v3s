<?
if (strpos($report_template, 'extended') === false) {
	$base_report_page_numbers = '2+3';
	$upper_report_page_number = '4';
}
else {
	$base_report_page_numbers = '2+3+4+5+6';
	$upper_report_page_number = '7';
}?> 

Modify_All_Graphs
/PAGE_NO=<?=$base_report_page_numbers;?> 
! /Y_MODIFY_RANGE=TRUE
! /Y_USE_AUTO_RANGE=TRUE
! /Y_MIN_BUFFER=
! /Y_MAX_BUFFER=
! /Y_MIN=
! /Y_MAX=
! /Y_SCALE_INCREMENT=
! /Y_AXIS_LABEL=
/X_AXIS_LABEL=<?=$graphXAxisTitle;?> 
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::UB_exists&" = "true") &::AMP& ("<?=$task;?>" <> "Balance"))
! /AS_INTEGER=TRUE
;

	Append_Report_Template
	/REPORT_TEMPLATE=<?=$reportTemplateDirectory . $report_template_UB;?> 
	;

	Modify_All_Graphs
	/PAGE_NO=<?=$upper_report_page_number;?> 
	! /Y_MODIFY_RANGE=TRUE
	! /Y_USE_AUTO_RANGE=TRUE
	! /Y_MIN_BUFFER=
	! /Y_MAX_BUFFER=
	! /Y_MIN=
	! /Y_MAX=
	! /Y_SCALE_INCREMENT=
	! /Y_AXIS_LABEL=
	/X_AXIS_LABEL=<?=$graphXAxisTitle;?> 
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

<?
if (strpos($report_template_append,'unspecified') === false) {
?> 

	Append_Report_Template
	/REPORT_TEMPLATE=<?=$reportTemplateDirectory . $report_template_append;?> 
	;

<?
}?> 

