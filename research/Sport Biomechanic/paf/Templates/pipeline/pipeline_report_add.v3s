/PAGE_NUMBER=1
/COLUMN_NUMBER=3
/ROW_NUMBER=1
! /COLUMN_SPAN=1
! /ROW_SPAN=1
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

Set_Text_Item
/SIGNAL_NAME=Report_title
/SIGNAL_FOLDER=META
/SIGNAL_DATA_VALUE=<?=$report_title; ?> 
;

<?
if (!empty($session["Injury"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Injury
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$session['Injury']; ?> 
	;
<?}

if (!empty($session["Injured_side"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Injured_side
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$session['Injured_side'];?> 
	;
<?}

if (!empty($session["Dominance"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Dominance
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$session['Dominance'];?> 
	;
<?
} 

if (!empty($session["Last_name"])) {
	$first_name = iconv('UTF-8', 'CP'.$CP_page, $session['First_name']);
	$last_name = iconv('UTF-8', 'CP'.$CP_page, $session['Last_name']);
?> 
	Set_Text_Item
	/SIGNAL_NAME=Name
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<? echo $first_name . ' ' . $last_name; ?> 
	;
<?}

if (!empty($subject["ID"])) {
	$subject_ID = iconv('UTF-8', 'CP'.$CP_page, $subject["ID"]);
?> 
	Set_Text_Item
	/SIGNAL_NAME=ID
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$subject_ID; ?> 
	;
<?}

if (!empty($subject["DOB"])) { ?> 
	Set_Text_Item
	/SIGNAL_NAME=DOB
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$subject['DOB'];?> 
	;
<?}

if (!empty($subsession["Height"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Height
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?echo (number_format(round(trim($subsession["Height"]),1),2).' m');?> 
	;
<?}
	
if (!empty($subsession["Weight"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Weight
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?echo (number_format(round(trim($subsession["Weight"]),1),1).' kg');?> 
	;
<?}
	
if (!empty($subsession["Comments"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Comments
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$subsession['Comments'];?> 
	;
<?}

if (!empty($subsession["Creation_date"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Creation_date
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<? echo (trim($subsession["Creation_date"]));?> 
	;
<?}

if (!empty($subsession["Creation_time"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Creation_time
	/SIGNAL_FOLDER=META
