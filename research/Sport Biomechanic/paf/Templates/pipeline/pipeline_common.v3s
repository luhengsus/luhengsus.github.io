! Velocities
First_Derivative
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=CenterOfMass+PelvisCGPos+Left Ankle Angles+Left Hip Angles+Left Knee Angles+Right Ankle Angles+Right Hip Angles+Right Knee Angles
/RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=_vel
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
;

!remove gimbal lock from shoulder angles
Evaluate_Expression
/EXPRESSION=resolve_discontinuity(LINK_MODEL_BASED::ORIGINAL::Left Shoulder Angles,360)
/RESULT_TYPES=LINK_MODEL_BASED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=Left Shoulder Angles
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION=resolve_discontinuity(LINK_MODEL_BASED::ORIGINAL::Right Shoulder Angles,360)
/RESULT_TYPES=LINK_MODEL_BASED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=Right Shoulder Angles
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Set_Pipeline_Parameter
/PARAMETER_NAME=left_trial_exists
/PARAMETER_VALUE=false
;

Set_Pipeline_Parameter
/PARAMETER_NAME=right_trial_exists
/PARAMETER_VALUE=false
;

<?
if (strpos($model_used,'Theia') !== false) {
	$left_terminal_segment = "LTO";
	$right_terminal_segment = "RTO";
	$terminal_segment_short = "TO";
}
else {
	$left_terminal_segment = "LFT";
	$right_terminal_segment = "RFT";
	$terminal_segment_short = "FT";
}
?> 
