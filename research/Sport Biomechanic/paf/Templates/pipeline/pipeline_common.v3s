	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Foot Pitch Angles
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=RMF
	/REFERENCE_SEGMENT=Virtual Lab
	/RESOLUTION_COORDINATE_SYSTEM=
