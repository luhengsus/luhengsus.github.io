<?php
// Include php variables.
include ($template_directory . 'settings.php');
include ($template_directory . 'Scripts\src\Visual3D\prepare_variables.php');

$model_used = $subsession['Model_used'];
$task = $subsession['Task'];
echo "! Model used: " . $model_used;
echo "\n! Task: " . $task;

$CP_page = sapi_windows_cp_get('ansi');	

// Allow user to specify force threshold in % of body weight
if (strpos($force_threshold_units, '%') !== false)
	$force_threshold = $session["Weight"] * $force_threshold * 0.01 * 9.81;
?> 

!Set the force threshold for the FP 
Set_Force_Platform_Threshold
/THRESHOLD=<?=$force_threshold;?> 
! /SET_AS_DEFAULT=FALSE
;

Set_Use_Processed_Analog
/USE_PROCESSED=TRUE
;

Set_Use_Processed_Targets
/USE_PROCESSED=TRUE
;

Set_Use_Processed_Forces
/USE_PROCESSED=TRUE
;

<?
if (strpos($model_used,'Theia') !== false)
	$stat_name = 'Static*_Theia.c3d';
else
	$stat_name = 'Static_' .$session['ID'].'_'.$subject['Last_name'].'.cmz';

$stat_dir = dirname($working_directory) . '\\Static*\\';

foreach (glob($stat_dir) as $my_static_dir) {
	foreach (glob($my_static_dir . $stat_name) as $my_static_name) {
		if (file_exists($my_static_name)) {
			$static_directory = iconv('UTF-8','CP'.$CP_page,$my_static_dir);
			$static_name = iconv('UTF-8','CP'.$CP_page,$my_static_name);
		}
	}
}

if (empty($static_name))
	echo "! No static trial exist.";
else
	echo "! Using " . $static_name . " from " . $static_directory;

if (file_exists($static_name) && strpos($model_used,'Theia') === false) { 
?> 

	File_Open
	/FILE_NAME=<?=$static_name;?> 
	! /SUFFIX=
	/SET_PROMPT=Open Static cmz
	! /FILTER=
	;

<?
}
elseif (!file_exists($static_name) && strpos($model_used,'Theia') === false && strpos($subsession['Task'],'Isometric') === false) { ?> 

	Pipeline_Breakpoint
	/PAUSE_MESSAGE=<?=$stat_name;?> not found. Static session must be processed first. Please halt processing and start static session processing.
	;
<?
}?> 

