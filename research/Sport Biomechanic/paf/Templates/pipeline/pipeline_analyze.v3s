?> 
	! Workaround for a situation when 'JUMP' tag is added to Single-Leg Jump Left/Right Markerless *_Theia.c3d
	Remove_Tags
	/MOTION_FILE_NAMES=ALL_FILES
	/TAGS=JUMP
	;
<?
}

if (file_exists($static_name)) {
?> 
	Set_Pipeline_Parameter_To_List_Of_Files
	/PARAMETER_NAME=static
	/FOLDER=<?=$static_directory;?> 
	! /SEARCH_SUBFOLDERS=FALSE
	/FILE_MASK=Static*.c3d
	;
<?
}

if (!$isometricExists) {
?> 
	Assign_Model_File
	/CALIBRATION_FILE=*.c3d
	/MOTION_FILE_NAMES=<?=$tag;?>+Static
	! /REMOVE_EXISTING_ASSIGNMENTS=FALSE
	;
<?
}?> 

File_Close
/FILE_NAME=Functional
! /QUERY=
;

<?
if (strpos($model_used,'Sports') !== false) {
?> 

	! Remove prefix 'Q_' if Skeleton solver Sports marker set is used.
	Remove_Prefix_From_Point_Labels
	/PREFIX=Q_
	! /INCLUDE_CAL_FILE=TRUE
	! /OVERWRITE_C3D_FILE=FALSE
	;
<?
}

if (strpos($model_used,'Theia') === false && (!$isometricExists)) {
?> 
	Build_Model
	/CALIBRATION_FILE=*.c3d
	! /REBUILD_ALL_MODELS=TRUE
	! /DISPLAY_RESULTS=TRUE
	;
<?
}?> 

!Virtual lab definition
!============================================
<?
if (!$isometricExists)
	include ($v3dScriptDirectory . 'pipeline_virtual_lab.v3s');
?> 

! Find out if upper body markers exist
!============================================
! We assume UB exists if 'SME or 'Chest' markers exist
Set_Pipeline_Parameter
/PARAMETER_NAME=UB_exists
/PARAMETER_VALUE=false
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=Data_Exists(TARGET::ORIGINAL::Chest) | Data_Exists(TARGET::ORIGINAL::SME) | ("<?=$model_used;?>" = "Theia")
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=UB_exists
	/PARAMETER_VALUE=true
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

!Open report template
!============================================
<?
include ($v3dScriptDirectory . 'pipeline_report_add.v3s');
?> 

!General parameters (same for all tasks)
!============================================
<?
if (!$isometricExists)
	include ($v3dScriptDirectory . 'pipeline_common.v3s');
?> 

!=======================================
Select_Active_File
/FILE_NAME=<?=$tag;?> 
! /QUERY=
;

! Zeroing force plates. Default is first 10 frames.
Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=((<?=$fp_zero_start;?> <> <?=$fp_zero_end;?>) &::AMP& (<?=$force_plates_zeroed;?> = 1))
! /AS_INTEGER=TRUE
;

	Modify_Force_Platform_Parameters
	/FP_ZERO=<?=$fp_zero_start;?>+<?=$fp_zero_end;?> 
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

! Halt script if event mode is set to 'Force Plates' but force data do not exist
<?
if (strpos($session['Event_mode'], 'Force Plates') !== false) {
?> 
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(FORCE::ORIGINAL::FP1) <> 1)
	! /AS_INTEGER=TRUE
	;

		Pipeline_Breakpoint
		/PAUSE_MESSAGE=Event mode is set to 'Force Plates' but no force data has been found. Halt the script and set event mode to 'No Force Plate (Automatic)' or 'Manual'.
		;

