Set_Pipeline_Parameter_To_List_Of_Tags
/PARAMETER_NAME=tags
;

For_Each
/ITERATION_PARAMETER_NAME=tag
! /ITERATION_PARAMETER_COUNT_NAME=
/ITEMS=::tags
;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(("&::tag&" <> "Static") &::AMP& ("&::tag&" <> "<?=$tag;?>"))
	! /AS_INTEGER=TRUE
	;

		Select_Active_File
		/FILE_NAME=::tag
		! /QUERY=
		;

		! Flight Time
		Metric_Time_Between_Events
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=FlightTime_&::tag
		/EVENT_SEQUENCE=TakeOff+TouchDown
		/EXCLUDE_EVENTS=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		;

		! Eccentric time
		Metric_Time_Between_Events
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=EccentricTime_&::tag
		/EVENT_SEQUENCE=PlotStart+Eccentric_end
		/EXCLUDE_EVENTS=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		;

		! Concentric time
		Metric_Time_Between_Events
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=ConcentricTime_&::tag
		/EVENT_SEQUENCE=Eccentric_end+TakeOff
		/EXCLUDE_EVENTS=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		;

		! Flight time to Contraction time ratio
		Evaluate_Expression
		/EXPRESSION=METRIC::PROCESSED::FlightTime_&::tag& / METRIC::PROCESSED::ConcentricTime_&::tag&
		/RESULT_TYPES=METRIC
		! /RESULT_FOLDERS=PROCESSED
		/RESULT_NAME=Flight_Contraction_time_ratio_&::tag
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=CenterOfMass
		/RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=COM_Z_TO_&::tag
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		! /SIGNAL_COMPONENTS=
		/COMPONENT_SEQUENCE=Z
		/EVENT_NAME=TakeOff
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Metric_Maximum
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=CenterOfMass_MAX_&::tag
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=CenterOfMass
		/SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_SEQUENCE=TakeOff+TouchDown
		/EXCLUDE_EVENTS=
		! /SEQUENCE_PERCENT_START=0
		! /SEQUENCE_PERCENT_END=100
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /CREATE_GLOBAL_MAXIMUM=FALSE
		;

		Metric_Minimum
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=CenterOfMass_MIN_&::tag
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=CenterOfMass
		/SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		!/EVENT_SEQUENCE=
		/EXCLUDE_EVENTS=
		! /SEQUENCE_PERCENT_START=0
		! /SEQUENCE_PERCENT_END=100
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /CREATE_GLOBAL_MAXIMUM=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=LINK_MODEL_BASED
		! /SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=CenterOfMass
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@PlotStart_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		/COMPONENT_SEQUENCE=Z
		/EVENT_NAME=PlotStart
		! /EVENT_INSTANCE=0
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		<?
		if (stripos($jump_height_method, 'static_trial') !== false) {
		?> 
			! Copy COM position from static trial (found in GLOBAL) to dynamic ones so that we can calculate COM displacement per trials (needed for web report)
			Evaluate_Expression
			/EXPRESSION=GLOBAL::METRIC::STATIC::CenterOfMass_mean_MEAN
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=STATIC
			/RESULT_NAME=CenterOfMass_mean_MEAN_&::tag
			;

			! Jump height from COM displacement
			Evaluate_Expression
			/EXPRESSION=METRIC::PROCESSED::CenterOfMass_MAX_&::tag&_MEAN::Z - METRIC::STATIC::CenterOfMass_mean_MEAN_&::tag&::Z
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_max_&::tag
			;

			! Com displacement (standing COM height - total COM height)
			Evaluate_Expression
			/EXPRESSION=METRIC::STATIC::CenterOfMass_mean_MEAN_&::tag&::Z - METRIC::PROCESSED::CenterOfMass_MIN_&::tag&_MEAN::Z
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_min_&::tag
			;

		<?
		}
		elseif (stripos($jump_height_method, 'takeoff_velocity') !== false) {
		?> 
			! Jump height from takeoff velocity
			! = vel@takeoff^2 /2g
			Metric_Signal_Value_At_Event
			/SIGNAL_TYPES=DERIVED
			/SIGNAL_FOLDER=PROCESSED
			/SIGNAL_NAMES=PelvisCGPos_vel
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=@TakeOff
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			! /SIGNAL_COMPONENTS=
			/COMPONENT_SEQUENCE=ALL
			/EVENT_NAME=TakeOff
			! /EVENT_INSTANCE=0
			/GENERATE_MEAN_AND_STDDEV=FALSE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Evaluate_Expression
			/EXPRESSION=(METRIC::PROCESSED::PelvisCGPos_vel@TakeOff::Z)^2 / (2 * 9.81)
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_max_&::tag
			;

			! Com displacement (COM height at PlotStart - total COM height)
			Evaluate_Expression
			/EXPRESSION=METRIC::PROCESSED::CenterOfMass@PlotStart_&::tag& - METRIC::PROCESSED::CenterOfMass_MIN_&::tag&_MEAN::Z
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_min_&::tag
			;
		<?
		}
		elseif (stripos($jump_height_method, 'flight_time') !== false) {
		?> 
			! Jump height from flight time
			! = 1/2g(t/2)^2
			Evaluate_Expression
			/EXPRESSION=0.5*9.81*(METRIC::PROCESSED::FlightTime_&::tag&/2)^2
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_max_&::tag
			;

			! Com displacement (COM height at PlotStart - total COM height)
			Evaluate_Expression
			/EXPRESSION=METRIC::PROCESSED::CenterOfMass@PlotStart_&::tag& - METRIC::PROCESSED::CenterOfMass_MIN_&::tag&_MEAN::Z
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_min_&::tag
			;
		<?
		}
		else {
		?> 
			! max pelvis height - pelvis height at takeoff
			Metric_Signal_Value_At_Event
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=PelvisCGPos
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=@TakeOff
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			! /SIGNAL_COMPONENTS=
			/COMPONENT_SEQUENCE=Z
			/EVENT_NAME=TakeOff
			! /EVENT_INSTANCE=0
			/GENERATE_MEAN_AND_STDDEV=FALSE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Metric_Maximum
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=_max_flight
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/SIGNAL_TYPES=LINK_MODEL_BASED
			! /SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=PelvisCGPos
			/COMPONENT_SEQUENCE=Z
			/EVENT_SEQUENCE=TakeOff+TouchDown
			/EXCLUDE_EVENTS=
			/SEQUENCE_PERCENT_START=
			/SEQUENCE_PERCENT_END=
			/GENERATE_MEAN_AND_STDDEV=FALSE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /CREATE_GLOBAL_MAXIMUM=FALSE
			;
			
			Evaluate_Expression
			/EXPRESSION=METRIC::PROCESSED::PelvisCGPos_max_flight - METRIC::PROCESSED::PelvisCGPos@TakeOff
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_max_&::tag
			;

			! Com displacement (COM height at PlotStart - total COM height)
			Evaluate_Expression
			/EXPRESSION=METRIC::PROCESSED::CenterOfMass@PlotStart_&::tag& - METRIC::PROCESSED::CenterOfMass_MIN_&::tag&_MEAN::Z
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=PROCESSED
			/RESULT_NAME=COM_displacement_MEAN_min_&::tag
			;
		<?
		}?> 

		! convert to [cm] for V3D report
		Evaluate_Expression
		/EXPRESSION=METRIC::PROCESSED::COM_displacement_MEAN_max_&::tag& * 100
		/RESULT_TYPE=METRIC
		/RESULT_FOLDER=PROCESSED
		/RESULT_NAME=COM_displacement_MEAN_max_&::tag&_cm
		;

		Evaluate_Expression
		/EXPRESSION=METRIC::PROCESSED::COM_displacement_MEAN_min_&::tag& * 100
		/RESULT_TYPE=METRIC
		/RESULT_FOLDER=PROCESSED
		/RESULT_NAME=COM_displacement_MEAN_min_&::tag&_cm
		;

		!calculate global mean
		Metric_Mean
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=_MEAN
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/SIGNAL_TYPES=METRIC
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=COM_displacement_MEAN_max_&::tag&_cm+COM_displacement_MEAN_min_&::tag&_cm
		! /COMPONENT_SEQUENCE=
		/EVENT_SEQUENCE=
		/EXCLUDE_EVENTS=
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		;

		! COM peak eccentric velocity
		Metric_Minimum
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=_min_eccentric_&::tag&
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=PelvisCGPos_vel
		/COMPONENT_SEQUENCE=ALL
		/EVENT_SEQUENCE=PlotStart+Eccentric_end
		/EXCLUDE_EVENTS=
		/SEQUENCE_PERCENT_START=
		/SEQUENCE_PERCENT_END=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /CREATE_GLOBAL_MINIMUM=FALSE
		;

		! Jump Height to Flight Time Ratio
		Evaluate_Expression
		/EXPRESSION=METRIC::PROCESSED::COM_displacement_MEAN_max_&::tag& / METRIC::PROCESSED::FlightTime_&::tag&
		/RESULT_TYPES=METRIC
		! /RESULT_FOLDERS=PROCESSED
		/RESULT_NAME=Jump_height_flight_time_ratio_&::tag
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		;

		Set_Pipeline_Parameter_To_List_Of_Tags
		/PARAMETER_NAME=my_tags
		! /GET_CURRENT_SELECTED_FILES=FALSE
		;

		! COM distance to knee and ankle
		Transform_Data_Coordinate_System
		/SIGNAL_TYPES=LINK_MODEL_BASED+LANDMARK+LANDMARK+LANDMARK+LANDMARK
		/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+ORIGINAL+ORIGINAL+ORIGINAL
		/SIGNAL_NAMES=CenterOfMass+L_KNEE+R_KNEE+L_ANKLE+R_ANKLE
		! /FROM_SEGMENT_CS=LAB
		/TO_SEGMENT_CS=Virtual Lab
		/RESULT_TYPES=DERIVED
		/RESULT_FOLDERS=VIRTUAL_LAB
		/RESULT_NAME=CenterOfMass+L_KNEE+R_KNEE+L_ANKLE+R_ANKLE
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
		! /ORIENTATION_ONLY=FALSE
		! /USE_DATA_RATE=FALSE
		;

		Subtract_Signals
		/SIGNAL_TYPES=DERIVED+DERIVED
		/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
		/SIGNAL_NAMES=CenterOfMass+L_Knee
		! /COMPONENT_SEQUENCE=
		! /RESULT_FOLDER=PROCESSED
		/RESULT_NAME=Left_Knee_COM_distance
		;

		Subtract_Signals
		/SIGNAL_TYPES=DERIVED+DERIVED
		/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
		/SIGNAL_NAMES=CenterOfMass+R_Knee
		! /COMPONENT_SEQUENCE=
		! /RESULT_FOLDER=PROCESSED
		/RESULT_NAME=Right_Knee_COM_distance
		;

		Subtract_Signals
		/SIGNAL_TYPES=DERIVED+DERIVED
		/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
		/SIGNAL_NAMES=CenterOfMass+L_Ankle
		! /COMPONENT_SEQUENCE=
		! /RESULT_FOLDER=PROCESSED
		/RESULT_NAME=Left_Ankle_COM_distance
		;

		Subtract_Signals
		/SIGNAL_TYPES=DERIVED+DERIVED
		/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
		/SIGNAL_NAMES=CenterOfMass+R_Ankle
		! /COMPONENT_SEQUENCE=
		! /RESULT_FOLDER=PROCESSED
		/RESULT_NAME=Right_Ankle_COM_distance
		;

		! Invert right signal to make lateral movement positive
		Multiply_Signals_By_Constant
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=Right_COP_COM_distance+Right_Knee_COM_distance+Right_Ankle_COM_distance
		/SIGNAL_COMPONENTS=X
		/RESULT_TYPES=DERIVED
		! /RESULT_FOLDERS=PROCESSED
		/RESULT_NAME=Right_COP_COM_distance+Right_Knee_COM_distance+Right_Ankle_COM_distance
		! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
		/CONSTANT=-1
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=Left_Knee_COM_distance+Right_Knee_COM_distance+Left_Ankle_COM_distance+Right_Ankle_COM_distance
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@TouchDown_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_NAME=TouchDown
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=Left_Knee_COM_distance+Right_Knee_COM_distance+Left_Ankle_COM_distance+Right_Ankle_COM_distance
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@TakeOff_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_NAME=TakeOff
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=Left_Knee_COM_distance+Right_Knee_COM_distance+Left_Ankle_COM_distance+Right_Ankle_COM_distance
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@Pelvis_lowest_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_NAME=Pelvis_lowest
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=Left Knee Angles+Right Knee Angles+Left Hip Angles+Right Hip Angles+Left Thorax Angles+Right Thorax Angles
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@TouchDown_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_NAME=TouchDown
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Metric_Signal_Value_At_Event
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=Left Ankle Angles+Left Knee Angles+Left Hip Angles+Right Ankle Angles+Right Knee Angles+Right Hip Angles+Left Thorax Angles+Right Thorax Angles
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=@COM_MIN_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		! /SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_NAME=COM_MIN
		/GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
		! /RETAIN_NO_DATA_VALUES=FALSE
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond2
		/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) = 1)
		! /AS_INTEGER=TRUE
		;
			
			Metric_Signal_Value_At_Event
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Left Hip Moment+Left Knee Moment+Left Ankle Moment
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=@COM_MIN_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			! /SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_NAME=COM_MIN
			/GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Metric_Maximum
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=_max_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Left Knee Moment
			/SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_SEQUENCE=PlotStart+TakeOff
			/EXCLUDE_EVENTS=
			! /SEQUENCE_PERCENT_START=0
			! /SEQUENCE_PERCENT_END=100
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /CREATE_GLOBAL_MAXIMUM=FALSE
			;

			Metric_Maximum
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=_max_landing_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Left Knee Moment
			/SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_SEQUENCE=TakeOff+EOF
			/EXCLUDE_EVENTS=
			! /SEQUENCE_PERCENT_START=0
			! /SEQUENCE_PERCENT_END=100
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /CREATE_GLOBAL_MAXIMUM=FALSE
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond2
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond2
		/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) = 1)
		! /AS_INTEGER=TRUE
		;
			
			Metric_Signal_Value_At_Event
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Right Hip Moment+Right Knee Moment+Right Ankle Moment
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=@COM_MIN_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			! /SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_NAME=COM_MIN
			/GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Metric_Maximum
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=_max_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Right Knee Moment
			/SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_SEQUENCE=PlotStart+TakeOff
			/EXCLUDE_EVENTS=
			! /SEQUENCE_PERCENT_START=0
			! /SEQUENCE_PERCENT_END=100
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /CREATE_GLOBAL_MAXIMUM=FALSE
			;

			Metric_Maximum
			! /RESULT_METRIC_FOLDER=PROCESSED
			/RESULT_METRIC_NAME=_max_landing_&::tag
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_FOLDER=ORIGINAL
			/SIGNAL_NAMES=Right Knee Moment
			/SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_SEQUENCE=TakeOff+EOF
			/EXCLUDE_EVENTS=
			! /SEQUENCE_PERCENT_START=0
			! /SEQUENCE_PERCENT_END=100
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /CREATE_GLOBAL_MAXIMUM=FALSE
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond2
		;

		Metric_Maximum
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=_max_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		!/SIGNAL_NAMES=Left Hip Angles+Right Hip Angles+Left Knee Angles+Right Knee Angles+Left Ankle Angles+Right Ankle Angles+Left Foot Progression+Right Foot Progression<?if(strpos($session['Event_mode'],"Force Plates") !== false) echo '+Left GRF+Right GRF';?> 
		/SIGNAL_NAMES=Left Hip Angles+Right Hip Angles+Left Knee Angles+Right Knee Angles+Left Ankle Angles+Right Ankle Angles+Left Foot Progression+Right Foot Progression
		/SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_SEQUENCE=PlotStart+TakeOff
		/EXCLUDE_EVENTS=
		! /SEQUENCE_PERCENT_START=0
		! /SEQUENCE_PERCENT_END=100
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /CREATE_GLOBAL_MAXIMUM=FALSE
		;

		Metric_Maximum
		! /RESULT_METRIC_FOLDER=PROCESSED
		/RESULT_METRIC_NAME=_max_landing_&::tag
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		!/SIGNAL_NAMES=Left Hip Angles+Right Hip Angles+Left Knee Angles+Right Knee Angles+Left Ankle Angles+Right Ankle Angles+Left Foot Progression+Right Foot Progression<?if(strpos($session['Event_mode'],"Force Plates") !== false) echo '+Left GRF+Right GRF';?> 
		/SIGNAL_NAMES=Left Hip Angles+Right Hip Angles+Left Knee Angles+Right Knee Angles+Left Ankle Angles+Right Ankle Angles+Left Foot Progression+Right Foot Progression
		/SIGNAL_COMPONENTS=
		! /COMPONENT_SEQUENCE=
		/EVENT_SEQUENCE=TouchDown+EOF
		/EXCLUDE_EVENTS=
		! /SEQUENCE_PERCENT_START=0
		! /SEQUENCE_PERCENT_END=100
		! /GENERATE_MEAN_AND_STDDEV=TRUE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		! /CREATE_GLOBAL_MAXIMUM=FALSE
		;
		! Bilateral CMJ
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION="&::tag&" = "<?=$tag;?>_B"
		! /AS_INTEGER=TRUE
		;

			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond2
			/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) = 1) | (Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) = 1)
			! /AS_INTEGER=TRUE
			;
			
				! COM-COP distance
				Transform_Data_Coordinate_System
				/SIGNAL_TYPES=KINETIC_KINEMATIC+KINETIC_KINEMATIC
				/SIGNAL_FOLDER=<?=$left_terminal_segment;?>+<?=$right_terminal_segment;?> 
				/SIGNAL_NAMES=COP_1+COP_1
				! /FROM_SEGMENT_CS=LAB
				/TO_SEGMENT_CS=Virtual Lab
				/RESULT_TYPES=DERIVED
				/RESULT_FOLDERS=VIRTUAL_LAB
				/RESULT_NAME=Left_COP+Right_COP
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				! /ORIENTATION_ONLY=FALSE
				! /USE_DATA_RATE=FALSE
				;

				Subtract_Signals
				/SIGNAL_TYPES=DERIVED+DERIVED
				/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
				/SIGNAL_NAMES=CenterOfMass+Left_COP
				! /COMPONENT_SEQUENCE=
				! /RESULT_FOLDER=PROCESSED
				/RESULT_NAME=Left_COP_COM_distance
				;

				Subtract_Signals
				/SIGNAL_TYPES=DERIVED+DERIVED
				/SIGNAL_FOLDER=VIRTUAL_LAB+VIRTUAL_LAB
				/SIGNAL_NAMES=CenterOfMass+Right_COP
				! /COMPONENT_SEQUENCE=
				! /RESULT_FOLDER=PROCESSED
				/RESULT_NAME=Right_COP_COM_distance
				;

				! Bilateral total force
				Evaluate_Expression
				/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::Left GRF + LINK_MODEL_BASED::ORIGINAL::Right GRF
				/RESULT_TYPE=DERIVED
				/RESULT_FOLDER=PROCESSED
				/RESULT_NAME=Total GRF
				;

				! Rate of force development
				First_Derivative
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Left_RFD+Right_RFD+Total_RFD
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
				;

				! Braking Force RFD 100ms
				Metric_Signal_Value_At_Event
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left_RFD+Right_RFD+Total_RFD
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=@TouchDown_100ms_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				! /SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_NAME=TouchDown_100ms
				! /EVENT_INSTANCE=0
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
				! /RETAIN_NO_DATA_VALUES=FALSE
				;

				! Braking Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Power (F * v)
				Evaluate_Expression
				/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::Left GRF * DERIVED::PROCESSED::PelvisCGPos_vel
				! /RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Left Power
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				;

				Evaluate_Expression
				/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::Right GRF * DERIVED::PROCESSED::PelvisCGPos_vel
				! /RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Right Power
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				;

				Evaluate_Expression
				/EXPRESSION=DERIVED::PROCESSED::Total GRF * DERIVED::PROCESSED::PelvisCGPos_vel
				! /RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Total Power
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				;

				! Peak Landing Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=TRUE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Landing Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Eccentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Eccentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Concentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Concentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_Concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED+LINK_MODEL_BASED+DERIVED
				/SIGNAL_FOLDER=ORIGINAL+ORIGINAL+PROCESSED
				/SIGNAL_NAMES=Left GRF+Right GRF+Total GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Eccentric Peak Power
				Metric_Minimum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_min_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power+Right Power+Total Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Concentric Peak Power
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power+Right Power+Total Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Eccentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power+Right Power+Total Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power+Right Power+Total Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond2
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;
		
		! Left CMJ
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION="&::tag&" = "<?=$tag;?>_L"
		! /AS_INTEGER=TRUE
		;

			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond2
			/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) = 1)
			! /AS_INTEGER=TRUE
			;

				! COM-COP distance
				Transform_Data_Coordinate_System
				/SIGNAL_TYPES=KINETIC_KINEMATIC
				/SIGNAL_FOLDER=<?=$left_terminal_segment;?> 
				/SIGNAL_NAMES=COP_1
				! /FROM_SEGMENT_CS=LAB
				/TO_SEGMENT_CS=Virtual Lab
				/RESULT_TYPES=DERIVED
				/RESULT_FOLDERS=VIRTUAL_LAB
				/RESULT_NAME=Left_COP
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				! /ORIENTATION_ONLY=FALSE
				! /USE_DATA_RATE=FALSE
				;

				Subtract_Signals
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=VIRTUAL_LAB
				/SIGNAL_NAMES=CenterOfMass+Left_COP
				! /COMPONENT_SEQUENCE=
				! /RESULT_FOLDER=PROCESSED
				/RESULT_NAME=Left_COP_COM_distance
				;

				! Rate of force development
				First_Derivative
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Left_RFD
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
				;

				! Braking Force RFD 100ms
				Metric_Signal_Value_At_Event
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left_RFD
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=@TouchDown_100ms
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				! /SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_NAME=TouchDown_100ms
				! /EVENT_INSTANCE=0
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
				! /RETAIN_NO_DATA_VALUES=FALSE
				;

				! Braking Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Power (F * v)
				Evaluate_Expression
				/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::Left GRF * DERIVED::PROCESSED::PelvisCGPos_vel
				! /RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Left Power
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				;

				! Peak Landing Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=TRUE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Landing Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Eccentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Eccentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Concentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Concentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_Concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Left GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Eccentric Peak Power
				Metric_Minimum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_min_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Concentric Peak Power
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Eccentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Left Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond2
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		! Right CMJ
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION="&::tag&" = "<?=$tag;?>_R"
		! /AS_INTEGER=TRUE
		;

			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond2
			/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) = 1)
			! /AS_INTEGER=TRUE
			;
			
				! COM-COP distance
				Transform_Data_Coordinate_System
				/SIGNAL_TYPES=KINETIC_KINEMATIC
				/SIGNAL_FOLDER=<?=$right_terminal_segment;?> 
				/SIGNAL_NAMES=COP_1
				! /FROM_SEGMENT_CS=LAB
				/TO_SEGMENT_CS=Virtual Lab
				/RESULT_TYPES=DERIVED
				/RESULT_FOLDERS=VIRTUAL_LAB
				/RESULT_NAME=Right_COP
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				! /ORIENTATION_ONLY=FALSE
				! /USE_DATA_RATE=FALSE
				;

				Subtract_Signals
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=VIRTUAL_LAB
				/SIGNAL_NAMES=CenterOfMass+Right_COP
				! /COMPONENT_SEQUENCE=
				! /RESULT_FOLDER=PROCESSED
				/RESULT_NAME=Right_COP_COM_distance
				;

				! Rate of force development
				First_Derivative
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Right_RFD
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
				;

				! Braking Force RFD 100ms
				Metric_Signal_Value_At_Event
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Right_RFD
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=@TouchDown_100ms
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				! /SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_NAME=TouchDown_100ms
				! /EVENT_INSTANCE=0
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
				! /RETAIN_NO_DATA_VALUES=FALSE
				;

				! Braking Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Impulse
				Metric_Integrate
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_impulse_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Power (F * v)
				Evaluate_Expression
				/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::Right GRF * DERIVED::PROCESSED::PelvisCGPos_vel
				! /RESULT_TYPES=DERIVED
				! /RESULT_FOLDERS=PROCESSED
				/RESULT_NAME=Right Power
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				;

				! Peak Landing Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=TRUE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Landing Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_landing_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=TouchDown+EOF
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Eccentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Eccentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Peak Concentric Force
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Mean Concentric Force
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_Concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=Right GRF
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Eccentric Peak Power
				Metric_Minimum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_min_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Right Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Concentric Peak Power
				Metric_Maximum
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_max_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Right Power
				/SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				! /SEQUENCE_PERCENT_START=0
				! /SEQUENCE_PERCENT_END=100
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /CREATE_GLOBAL_MAXIMUM=FALSE
				;

				! Eccentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_eccentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Right Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=PlotStart+Eccentric_end
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

				! Concentric Mean Power
				Metric_Mean
				! /RESULT_METRIC_FOLDER=PROCESSED
				/RESULT_METRIC_NAME=_mean_concentric_&::tag&
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				/SIGNAL_TYPES=DERIVED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=Right Power
				/SIGNAL_COMPONENTS=
				/EVENT_SEQUENCE=Eccentric_end+TakeOff
				/EXCLUDE_EVENTS=
				/GENERATE_MEAN_AND_STDDEV=FALSE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond2
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

End_For_Each
/ITERATION_PARAMETER_NAME=tag
;
