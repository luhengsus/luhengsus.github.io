!Create ploting events for reports
!----------------------------------------
<?
if ($LRExists) {
	$tagLeft = $tag . '_L';
	$tagRight = $tag . '_R';
}
else {
	$tagLeft = $tag;
	$tagRight = $tag;
}
?> 

Select_Active_File
/FILE_NAME=<?=$tagRight;?> 
! /QUERY=
;

Event_Copy
/EVENT_NAME=<?=$plotStartEventRight;?> 
/NEW_EVENT_NAME=<?=$webReportStartEventRight;?> 
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
! /EVENT_INSTANCE=0
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
;

