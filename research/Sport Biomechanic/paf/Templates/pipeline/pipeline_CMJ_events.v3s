Select_Active_File
/FILE_NAME=<?=$tag;?> 
! /QUERY=
;

<?
if (strpos($session['Event_mode'], 'Force Plates') !== false) {
?> 
	! Automatic_Gait_Events
	! ! /FRAME_WINDOW=8
	! /USE_TPR=FALSE
	! ;
<?
}?> 

Event_Explicit
/EVENT_NAME=BOF
/FRAME=3
! /TIME=
;

Event_Explicit
/EVENT_NAME=EOF
/FRAME=EOF
! /TIME=
;

! Decide side and create corresponding tags
Set_Pipeline_Parameter_To_List_Of_Tagged_Files
/PARAMETER_NAME=sc_files
/TAG_NAME=<?=$tag;?> 
! /GET_CURRENT_SELECTED_FILES=false
! /USE_SHORT_FILENAMES=false
;

For_Each
/ITERATION_PARAMETER_NAME=filename
/ITEMS=::sc_files
;

	Select_Active_File
	/FILE_NAME=::filename
	! /QUERY=
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) &::AMP& Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=<?=$tag;?>_B
		; 

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;
	
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) &::AMP& (Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) <> 1))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=<?=$tag;?>_R 
		; 

		Set_Pipeline_Parameter
		/PARAMETER_NAME=right_trial_exists
		/PARAMETER_VALUE=true
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;
	
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) &::AMP& (Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) <> 1))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=<?=$tag;?>_L
		; 

		Set_Pipeline_Parameter
		/PARAMETER_NAME=left_trial_exists
		/PARAMETER_VALUE=true
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

End_For_Each
/ITERATION_PARAMETER_NAME=filename
;

Select_Active_File
/FILE_NAME=<?=$tag;?>_L+<?=$tag;?>_B
! /QUERY=
;

! Find flight phase (we assume that foot dist end max vertical height happens during flight phase)
Event_Global_Maximum
/RESULT_EVENT_NAME=Left_max_toe_height
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=LFT
/SIGNAL_NAMES=DistEndPos
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
! /EVENT_SEQUENCE=LOFF+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Search for peak landing force between inflight and EOF events
Event_Global_Maximum
/RESULT_EVENT_NAME=Left_Peak_landing_force
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=Left_max_toe_height+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Create a new Left_Peak_landing_force event and add 1 frame offset (this event will only be used in the range when deleting extra LON events)
Event_Copy
/EVENT_NAME=Left_Peak_landing_force
/NEW_EVENT_NAME=Left_Peak_landing_force_offset
! /EVENT_INSTANCE=0
! /EVENT_INSTANCE_AS_LIST=FALSE
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=1
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=LON
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+Left_Peak_landing_force
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Threshold
/RESULT_EVENT_NAME=LOFF
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=1
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+LON
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=FALSE
/ON_DESCENT=TRUE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

! Delete false ON events between peak landing force and EOF
Event_Delete
/EVENT_NAME=LON
/EVENT_SEQUENCE=Left_Peak_landing_force_offset+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

! Delete false OFF events between ON and EOF
Event_Delete
/EVENT_NAME=LOFF
/EVENT_SEQUENCE=LON+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

Event_Copy
/EVENT_NAME=LON
/NEW_EVENT_NAME=TouchDown_L
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Copy
/EVENT_NAME=LOFF
/NEW_EVENT_NAME=TakeOff_L
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=PlotStart_L
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PelvisCGPos_vel
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
/TIME_OFFSET=0.1
/EVENT_SEQUENCE=BOF+TakeOff_L
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0
/ON_ASCENT=FALSE
/ON_DESCENT=TRUE
!/FRAME_WINDOW=PARAMETERS::POINT::RATE / 3 !tested for point rate of 50 Hz and 100 Hz
/FRAME_WINDOW=1
! /ENSURE_FRAMES_BEFORE=FALSE
/ENSURE_FRAMES_AFTER=TRUE
;

Event_Copy
/EVENT_NAME=TouchDown_L
/NEW_EVENT_NAME=TouchDown_100ms
! /EVENT_INSTANCE=0
! /EVENT_INSTANCE_AS_LIST=FALSE
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
! /FRAME_OFFSET=
/TIME_OFFSET=0.1
! /PERCENT_OFFSET=
;

Event_Global_Minimum
/RESULT_EVENT_NAME=Pelvis_lowest
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=PelvisCGPos
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_L+TakeOff_L
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
;

Event_Global_Minimum
/RESULT_EVENT_NAME=COM_MIN
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=CenterOfMass
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_L+TakeOff_L
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
;

Event_Threshold
/RESULT_EVENT_NAME=Eccentric_end
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PelvisCGPos_vel
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_L+TakeOff_L
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
/THRESHOLD=0
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Select_Active_File
/FILE_NAME=<?=$tag;?>_R+<?=$tag;?>_B
! /QUERY=
;

! Find flight phase (we assume that foot dist end max vertical height happens during flight phase)
Event_Global_Maximum
/RESULT_EVENT_NAME=Right_max_toe_height
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=RFT
/SIGNAL_NAMES=DistEndPos
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
! /EVENT_SEQUENCE=LOFF+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Search for peak landing force between inflight and EOF events
Event_Global_Maximum
/RESULT_EVENT_NAME=Right_Peak_landing_force
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Right GRF
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=Right_max_toe_height+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Create a new Right_Peak_landing_force event and add 1 frame offset (this event will only be used in the range when deleting extra RON events)
Event_Copy
/EVENT_NAME=Right_Peak_landing_force
/NEW_EVENT_NAME=Right_Peak_landing_force_offset
! /EVENT_INSTANCE=0
! /EVENT_INSTANCE_AS_LIST=FALSE
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=1
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=RON
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Right GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+Right_Peak_landing_force
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Threshold
/RESULT_EVENT_NAME=ROFF
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Right GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=1
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+RON
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=FALSE
/ON_DESCENT=TRUE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Delete
/EVENT_NAME=RON
/EVENT_SEQUENCE=Right_Peak_landing_force_offset+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

Event_Delete
/EVENT_NAME=ROFF
/EVENT_SEQUENCE=RON+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

Event_Copy
/EVENT_NAME=RON
/NEW_EVENT_NAME=TouchDown_R
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Copy
/EVENT_NAME=ROFF
/NEW_EVENT_NAME=TakeOff_R
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=PlotStart_R
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PelvisCGPos_vel
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
/TIME_OFFSET=0.1
/EVENT_SEQUENCE=BOF+TakeOff_R
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0
/ON_ASCENT=FALSE
/ON_DESCENT=TRUE
!/FRAME_WINDOW=PARAMETERS::POINT::RATE / 3 !tested for point rate of 50 Hz and 100 Hz
/FRAME_WINDOW=1
! /ENSURE_FRAMES_BEFORE=FALSE
/ENSURE_FRAMES_AFTER=TRUE
;

Event_Copy
/EVENT_NAME=TouchDown_R
/NEW_EVENT_NAME=TouchDown_100ms
! /EVENT_INSTANCE=0
! /EVENT_INSTANCE_AS_LIST=FALSE
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
! /FRAME_OFFSET=
/TIME_OFFSET=0.1
! /PERCENT_OFFSET=
;

Event_Global_Minimum
/RESULT_EVENT_NAME=Pelvis_lowest
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=PelvisCGPos
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_R+TakeOff_R
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
;

Event_Global_Minimum
/RESULT_EVENT_NAME=COM_MIN
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=CenterOfMass
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_R+TakeOff_R
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
;

Event_Threshold
/RESULT_EVENT_NAME=Eccentric_end
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PelvisCGPos_vel
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=PlotStart_R+TakeOff_R
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
/THRESHOLD=0
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

For_Each
/ITERATION_PARAMETER_NAME=filename
/ITEMS=::sc_files
;

	Select_Active_File
	/FILE_NAME=::filename
	! /QUERY=
	;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::LOFF) &::AMP& Data_Exists(EVENT_LABEL::ORIGINAL::ROFF)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=(EVENT_LABEL::ORIGINAL::LOFF + EVENT_LABEL::ORIGINAL::ROFF) / 2
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TakeOff
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

        Evaluate_Expression
        /EXPRESSION=(EVENT_LABEL::ORIGINAL::PlotStart_L + EVENT_LABEL::ORIGINAL::PlotStart_R) / 2
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=PlotStart
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::LOFF) &::AMP& (Data_Exists(EVENT_LABEL::ORIGINAL::ROFF) <> 1)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::LOFF
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TakeOff
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::PlotStart_L
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=PlotStart
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::ROFF) &::AMP& (Data_Exists(EVENT_LABEL::ORIGINAL::LOFF) <> 1)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::ROFF
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TakeOff
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::PlotStart_R
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=PlotStart
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::LON) &::AMP& Data_Exists(EVENT_LABEL::ORIGINAL::RON)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=(EVENT_LABEL::ORIGINAL::LON + EVENT_LABEL::ORIGINAL::RON) / 2
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TouchDown
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::LON) &::AMP& (Data_Exists(EVENT_LABEL::ORIGINAL::RON) <> 1)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::LON
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TouchDown
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=cond
    /EXPRESSION=Data_Exists(EVENT_LABEL::ORIGINAL::RON) &::AMP& (Data_Exists(EVENT_LABEL::ORIGINAL::LON) <> 1)
    ! /AS_INTEGER=TRUE
    ;

        Evaluate_Expression
        /EXPRESSION=EVENT_LABEL::ORIGINAL::RON
        /RESULT_TYPES=EVENT_LABEL
        /RESULT_FOLDERS=ORIGINAL
        /RESULT_NAME=TouchDown
        ! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=cond
	;

	! Place PlotEnd event 0.75s after TouchDown or to EOF if it happens sooner
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(EVENT_LABEL::ORIGINAL::EOF - EVENT_LABEL::ORIGINAL::TouchDown_L) <= 0.75
	! /AS_INTEGER=TRUE
	;

		Event_Copy
		/EVENT_NAME=EOF
		/NEW_EVENT_NAME=PlotEnd_L
		! /EVENT_INSTANCE=0
		! /RANGE_INSTANCE=0
		! /EVENT_SEQUENCE=
		! /EXCLUDE_EVENTS=
		! /START_AT_EVENT=
		! /END_AT_EVENT=
		! /FRAME_OFFSET=
		/TIME_OFFSET=0
		! /PERCENT_OFFSET=
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(EVENT_LABEL::ORIGINAL::EOF - EVENT_LABEL::ORIGINAL::TouchDown_L) > 0.75
	! /AS_INTEGER=TRUE
	;

		Event_Copy
		/EVENT_NAME=TouchDown_L
		/NEW_EVENT_NAME=PlotEnd_L
		! /EVENT_INSTANCE=0
		! /RANGE_INSTANCE=0
		! /EVENT_SEQUENCE=
		! /EXCLUDE_EVENTS=
		! /START_AT_EVENT=
		! /END_AT_EVENT=
		! /FRAME_OFFSET=
		/TIME_OFFSET=0.75
		! /PERCENT_OFFSET=
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	! Place PlotEnd event 0.75s after TouchDown or to EOF if it happens sooner
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(EVENT_LABEL::ORIGINAL::EOF - EVENT_LABEL::ORIGINAL::TouchDown_R) <= 0.75
	! /AS_INTEGER=TRUE
	;

		Event_Copy
		/EVENT_NAME=EOF
		/NEW_EVENT_NAME=PlotEnd_R
		! /EVENT_INSTANCE=0
		! /RANGE_INSTANCE=0
		! /EVENT_SEQUENCE=
		! /EXCLUDE_EVENTS=
		! /START_AT_EVENT=
		! /END_AT_EVENT=
		! /FRAME_OFFSET=
		/TIME_OFFSET=0
		! /PERCENT_OFFSET=
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(EVENT_LABEL::ORIGINAL::EOF - EVENT_LABEL::ORIGINAL::TouchDown_R) > 0.75
	! /AS_INTEGER=TRUE
	;

		Event_Copy
		/EVENT_NAME=TouchDown_R
		/NEW_EVENT_NAME=PlotEnd_R
		! /EVENT_INSTANCE=0
		! /RANGE_INSTANCE=0
		! /EVENT_SEQUENCE=
		! /EXCLUDE_EVENTS=
		! /START_AT_EVENT=
		! /END_AT_EVENT=
		! /FRAME_OFFSET=
		/TIME_OFFSET=0.75
		! /PERCENT_OFFSET=
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

End_For_Each
/ITERATION_PARAMETER_NAME=filename
;

